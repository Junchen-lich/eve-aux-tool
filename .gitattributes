# 换行符策略
#
# 本仓库在 Windows 上开发（core.autocrlf=true），若不显式声明，
# .sh 脚本检出到 Linux/macOS 会变成 CRLF，导致 "bad interpreter: /bin/bash^M"。
#
# 规则：
#   *.sh       强制 LF      —— 供 Unix 直接执行
#   *.cmd      强制 CRLF    —— 供 cmd.exe 执行
#   *.js       保持 LF      —— 跨平台一致，避免 shell 解析差异
#   *.md *.json 保持 LF
#   其余文本   不做转换

*.sh    text eol=lf
*.cmd   text eol=crlf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.conf  text eol=lf
*.service text eol=lf
*.html  text eol=lf
*.css   text eol=lf

# 二进制文件，不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.xlsx  binary
*.zip   binary
