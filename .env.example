# EVE 辅助工具 —— 服务端环境变量模板
#
# 部署到专用服务器时复制为 .env 并按实际修改：
#   cp .env.example .env
#
# ★ 该文件含密钥，切勿提交到 Git（已在 .gitignore 中排除 .env）

# ---------- 监听 ----------
# 只绑回环，由 Nginx 反代对外（推荐）
HOST=127.0.0.1
PORT=8657

# 外部访问基址：用于推导 SSO 回调地址，必须与 EVE 开发者后台登记的一致
BASE_URL=https://eve.example.com

# ---------- 应用 ----------
# EVE 开发者后台的 Client ID（欧服与国服各一个，用 EVE_CLIENT_ID_CN 区分）
EVE_CLIENT_ID=
EVE_CLIENT_ID_CN=

# ---------- 多用户 ----------
# 设为 1 启用注册 + 登录 + 数据隔离
# 公网部署必须为 1，否则任何人可读你的角色数据
EVE_MULTI_USER=1

# 服务端盐：留空则自动生成并持久化到 用户数据/server_salt.txt
# ★ 迁移服务器时必须一并保留，否则已有用户的会话全部失效
EVE_SALT=

# 会话有效期（秒），默认 7 天
SESSION_TTL=604800

# ---------- 反向代理 ----------
# 置于 Nginx 之后设为 1，日志才记录真实客户端 IP
TRUST_PROXY=1

# ---------- 运维 ----------
NODE_ENV=production
